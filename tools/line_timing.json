{
  "total": 69.04,
  "lines": [
    {
      "line": 1,
      "text": "مَنَم شیرِ ژیانِ قِزِلباش!",
      "start": 0.3,
      "end": 3.46,
      "chunks": [
        0,
        0
      ]
    },
    {
      "line": 2,
      "text": "البته... قبل از این‌که شیر بشویم، خیلی دویدیم؛ بیشتر هم دنبالِ اسب‌هایمان!",
      "start": 4.34,
      "end": 9.42,
      "chunks": [
        1,
        2
      ]
    },
    {
      "line": 3,
      "text": "ما از طایفه‌های مختلف آمدیم؛ با کلاه‌های سرخ، شمشیرهای تیز، و وفاداری به خاندانِ صَفَوی.",
      "start": 10.78,
      "end": 18.44,
      "chunks": [
        3,
        5
      ]
    },
    {
      "line": 4,
      "text": "دورِ شاه‌اسماعیل جمع شدیم؛ جوان بود، امّا رؤیایش کوچک نبود.",
      "start": 19.58,
      "end": 25.92,
      "chunks": [
        6,
        9
      ]
    },
    {
      "line": 5,
      "text": "ما جنگیدیم، او شاه شد، و کم‌کم صاحبِ منصب و قدرت شدیم.",
      "start": 26.34,
      "end": 30.14,
      "chunks": [
        10,
        11
      ]
    },
    {
      "line": 6,
      "text": "دیروز دنبالِ زینِ اسب بودیم؛ امروز دنبالِ صندلیِ بهتر!",
      "start": 31.26,
      "end": 35.48,
      "chunks": [
        12,
        13
      ]
    },
    {
      "line": 7,
      "text": "[خنده کوتاه]",
      "start": 36.7,
      "end": 37.96,
      "chunks": [
        14,
        14
      ]
    },
    {
      "line": 8,
      "text": "امّا وقتی چند سردار، هم‌زمان، خودشان را مهم‌ترین مردِ مملکت بدانند...",
      "start": 38.3,
      "end": 43.92,
      "chunks": [
        15,
        16
      ]
    },
    {
      "line": 9,
      "text": "خب، جلسه کوتاه نمی‌شود!",
      "start": 45.04,
      "end": 46.04,
      "chunks": [
        17,
        17
      ]
    },
    {
      "line": 10,
      "text": "رقابت‌ها بالا گرفت.",
      "start": 47.14,
      "end": 47.54,
      "chunks": [
        18,
        18
      ]
    },
    {
      "line": 11,
      "text": "بعدها، شاه‌عباس برای مهارِ قدرتِ ما، نیروی تازه‌ای به سپاه آورد؛ تا همه‌چیز به قزلباش‌ها وابسته نباشد.",
      "start": 47.94,
      "end": 55.32,
      "chunks": [
        19,
        21
      ]
    },
    {
      "line": 12,
      "text": "آن‌وقت فهمیدیم:",
      "start": 56.42,
      "end": 57.14,
      "chunks": [
        22,
        22
      ]
    },
    {
      "line": 13,
      "text": "رسیدن به قدرت، یک جنگ است؛ نگه‌داشتنش، هزار جنگ!",
      "start": 57.82,
      "end": 58.84,
      "chunks": [
        23,
        23
      ]
    },
    {
      "line": 14,
      "text": "حالا...",
      "start": 59.14,
      "end": 59.98,
      "chunks": [
        24,
        24
      ]
    },
    {
      "line": 15,
      "text": "کلاه مرا بیاورید؛ بی‌کلاه، این‌همه اُبُهَت هدر می‌رود!",
      "start": 60.6,
      "end": 65.4,
      "chunks": [
        25,
        28
      ]
    },
    {
      "line": 16,
      "text": "[خنده کوتاه]",
      "start": 66.16,
      "end": 68.3,
      "chunks": [
        29,
        29
      ]
    }
  ]
}